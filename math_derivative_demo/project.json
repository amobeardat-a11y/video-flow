  "captions": [
    {
      "start": 0.3,
      "end": 4.0,
      "text": "Bạn có đang học đạo hàm như một cái máy?"
    },
    {
      "start": 4.1,
      "end": 8.2,
      "text": "Sai lầm lớn nhất là cắm đầu học vẹt công thức."
    },
    {
      "start": 8.3,
      "end": 12.5,
      "text": "Thực chất đạo hàm không hề phức tạp như bạn nghĩ."
    },
    {
      "start": 12.6,
      "end": 16.8,
      "text": "Nó đo lường tốc độ biến đổi tức thời tại một thời điểm."
    },
    {
      "start": 16.9,
      "end": 21.2,
      "text": "Khi khoảng thời gian xét tiến dần về không."
    },
    {
      "start": 21.3,
      "end": 25.8,
      "text": "Ví dụ khi lái xe, quãng đường chia thời gian là vận tốc."
    },
    {
      "start": 25.9,
      "end": 30.2,
      "text": "Kim đồng hồ chỉ đúng 60 km/h tại giây thứ năm."
    },
    {
      "start": 30.3,
      "end": 35.0,
      "text": "Đó chính là đạo hàm của chuyển động theo thời gian."
    },
    {
      "start": 35.1,
      "end": 40.5,
      "text": "Về mặt hình học, phóng to đường cong vô hạn lần,"
    },
    {
      "start": 40.6,
      "end": 46.0,
      "text": "Độ dốc của đường tiếp tuyến đó chính là đạo hàm!"
    },
    {
      "start": 46.1,
      "end": 50.0,
      "text": "Muốn học chuẩn, hãy bắt đầu từ sự trực quan."
    },
    {
      "start": 50.1,
      "end": 53.67,
      "text": "Hiểu bản chất trước, công thức tự khắc dễ nhớ!"
    }
  ],
